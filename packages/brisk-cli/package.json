{
  "name": "@brisk/cli",
  "version": "0.1.0",
  "description": "Brisk CLI: brisk doctor / brisk serve / brisk chrome",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandlll-lee/Brisk-browser.git",
    "directory": "packages/brisk-cli"
  },
  "bugs": {
    "url": "https://github.com/brandlll-lee/Brisk-browser/issues"
  },
  "homepage": "https://github.com/brandlll-lee/Brisk-browser#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "bin": {
    "brisk": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "brisk": "tsx src/index.ts"
  },
  "dependencies": {
    "@brisk/types": "workspace:^",
    "@brisk/core": "workspace:^",
    "@brisk/ipc": "workspace:^",
    "@brisk/mcp": "workspace:^",
    "@brisk/skills": "workspace:^",
    "@hono/node-server": "catalog:",
    "commander": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:"
  }
}
