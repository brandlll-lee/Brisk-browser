# Brisk pnpm configuration

# Strict modules — surfaces accidental phantom deps early
strict-peer-dependencies=true
auto-install-peers=true
dedupe-peer-dependents=true

# Use hoisted node_modules only at root, isolated per package below
# (default in pnpm 10, listed here for clarity)
node-linker=isolated

# Workspace package linking
prefer-workspace-packages=true
link-workspace-packages=true
save-workspace-protocol=rolling

# Save catalog: protocol when adding deps that are in the catalog
save-catalog-mode=prefer

# Lockfile
lockfile=true

# Engine strict — refuse install on wrong Node version
engine-strict=true

# Don't store full registry log noise
loglevel=warn
